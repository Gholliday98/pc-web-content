{"content":[{"id":"hero001","elType":"container","settings":{"content_width":"full","min_height":{"unit":"vw","size":30},"flex_direction":"column","flex_justify_content":"flex-end","flex_align_items":"flex-start","background_background":"classic","background_image":{"url":"https://plastic-craft.com/wp-content/uploads/2026/03/cad.webp","id":"","size":""},"background_position":"center center","background_size":"cover","background_overlay_background":"gradient","background_overlay_color":"rgba(0,0,0,0.50)","background_overlay_color_b":"transparent","background_overlay_gradient_type":"linear","background_overlay_gradient_angle":{"unit":"deg","size":0},"padding":{"unit":"px","top":"80","right":"60","bottom":"60","left":"60","isLinked":false}},"elements":[{"id":"hero002","elType":"widget","widgetType":"heading","settings":{"title":"CAD Design & Rapid Prototyping Services","header_size":"h1","align":"left","title_color":"#FFFFFF","typography_typography":"custom","typography_font_family":"Montserrat","typography_font_size":{"unit":"rem","size":3.2},"typography_font_weight":"700","typography_text_transform":"uppercase","typography_letter_spacing":{"unit":"px","size":4},"text_shadow_text_shadow":{"horizontal":0,"vertical":2,"blur":20,"color":"rgba(0,0,0,0.7)"}},"elements":[]},{"id":"hero003","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 1.15rem; line-height: 1.6; color: rgba(255,255,255,0.9); max-width: 680px;\">From concept to physical prototype &mdash; CAD design, DFM review, and rapid prototype manufacturing in plastic and metal, all under one roof.</p>","_margin":{"unit":"px","top":"12","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[]}],"isInner":false},{"id":"css001","elType":"container","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"css002","elType":"widget","widgetType":"html","settings":{"html":"<style>\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Alice&family=Montserrat:wght@300;400;500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');\n\n:root {\n  --color-primary:        #1380da;\n  --color-primary-light:  #64b7f0;\n  --color-primary-pale:   #d0e9fd;\n  --color-primary-bright: #2e8eff;\n  --color-accent-blue:    #031aec;\n  --color-accent-indigo:  #0b108b;\n  --color-navy:           #07276e;\n  --color-navy-deep:      #03325e;\n  --color-white:          #ffffff;\n  --color-gray:           #666666;\n  --color-gray-blue:      #83b1d1;\n  --color-gray-light:     #d4e1ed;\n  --font-heading:    'Playfair Display', Georgia, serif;\n  --font-body:       'Lora', Georgia, serif;\n  --font-ui:         'Montserrat', sans-serif;\n  --max-width:       1200px;\n  --border-radius:   6px;\n  --shadow-sm:  0 1px 3px rgba(3,50,94,0.08);\n  --shadow-md:  0 4px 12px rgba(3,50,94,0.12);\n  --shadow-lg:  0 8px 30px rgba(3,50,94,0.16);\n}\n\n/* \u2500\u2500 SECTION LABEL \u2500\u2500 */\n.cad-section-label {\n  font-family: var(--font-ui);\n  font-size: 0.85rem;\n  font-weight: 700;\n  color: #1380da;\n  text-transform: uppercase;\n  letter-spacing: 1.5px;\n}\n\n/* \u2500\u2500 SERVICE CARDS \u2500\u2500 */\n.cad-service-card {\n  background: #fff;\n  border: 1px solid var(--color-gray-light);\n  border-radius: var(--border-radius);\n  padding: 28px 26px;\n  transition: box-shadow 0.3s ease;\n}\n.cad-service-card:hover { box-shadow: var(--shadow-md); }\n.cad-service-card h4 {\n  font-family: var(--font-ui);\n  font-size: 0.95rem;\n  font-weight: 700;\n  color: var(--color-navy-deep);\n  margin: 0 0 8px 0;\n}\n.cad-service-card p {\n  font-family: var(--font-body);\n  font-size: 0.88rem;\n  color: var(--color-gray);\n  line-height: 1.7;\n  margin: 0;\n}\n\n/* \u2500\u2500 FAQ \u2500\u2500 */\n.faq-item {\n  border-bottom: 1px solid var(--color-gray-light);\n  padding: 24px 0;\n}\n.faq-item:last-child { border-bottom: none; }\n.faq-q {\n  font-family: var(--font-ui);\n  font-size: 1rem;\n  font-weight: 600;\n  color: var(--color-navy-deep);\n  cursor: pointer;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 16px;\n}\n.faq-q::after {\n  content: '+';\n  font-size: 1.3rem;\n  font-weight: 300;\n  color: var(--color-primary);\n  transition: transform 0.3s;\n  flex-shrink: 0;\n}\n.faq-item.open .faq-q::after { content: '\\2212'; }\n.faq-a {\n  max-height: 0;\n  overflow: hidden;\n  transition: max-height 0.4s ease, padding 0.3s ease;\n  padding-top: 0;\n}\n.faq-item.open .faq-a {\n  max-height: 600px;\n  padding-top: 14px;\n}\n.faq-a p {\n  font-family: var(--font-body);\n  font-size: 0.92rem;\n  color: var(--color-gray);\n  line-height: 1.75;\n}\n\n/* \u2500\u2500 SCROLL \u2500\u2500 */\n.cap-page-fade {\n  opacity: 0;\n  transform: translateY(20px);\n  transition: opacity 0.6s ease, transform 0.6s ease;\n}\n.cap-page-fade.visible {\n  opacity: 1;\n  transform: translateY(0);\n}\n</style>"},"elements":[]}],"isInner":false},{"id":"wis001","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":800},"flex_direction":"column","flex_align_items":"center","padding":{"unit":"px","top":"36","right":"40","bottom":"32","left":"40","isLinked":false},"background_background":"classic","background_color":"#FFFFFF"},"elements":[{"id":"wis002","elType":"widget","widgetType":"heading","settings":{"title":"What Is Rapid Prototyping?","header_size":"h2","align":"center","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.8},"typography_font_weight":"700","_margin":{"unit":"px","top":"0","right":"0","bottom":"14","left":"0","isLinked":false}},"elements":[]},{"id":"wis003","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 1.05rem; line-height: 1.85; color: #4A5568; text-align: center;\">Turning an idea into a manufacturable part requires more than a good design &mdash; it requires a manufacturing partner who understands how materials behave, where designs can be simplified, and how to get a functional prototype in your hands as fast as possible. Plastic-Craft provides end-to-end support from initial CAD design through rapid prototype production, helping engineers and product teams move from concept to testable part with confidence.</p><p style=\"font-family: 'Lora', serif; font-size: 1.05rem; line-height: 1.85; color: #4A5568; text-align: center; margin-top: 14px;\">Rapid prototyping is the process of quickly producing a physical part or assembly from a digital design &mdash; typically a 3D CAD model &mdash; for the purpose of testing form, fit, and function before committing to full production tooling or volume manufacturing. Unlike production manufacturing, rapid prototyping prioritizes turnaround time and design flexibility over cost-per-unit.</p>","align":"center"},"elements":[]}],"isInner":false},{"id":"cad01","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":800},"flex_direction":"column","padding":{"unit":"px","top":"56","right":"40","bottom":"20","left":"40","isLinked":false},"background_background":"classic","background_color":"#F8FAFC","border_border":"solid","border_width":{"unit":"px","top":"1","right":"0","bottom":"0","left":"0","isLinked":false},"border_color":"#E2E8F0"},"elements":[{"id":"cad02","elType":"widget","widgetType":"heading","settings":{"title":"CAD Design Services","header_size":"h2","align":"center","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.8},"typography_font_weight":"700","_margin":{"unit":"px","top":"0","right":"0","bottom":"10","left":"0","isLinked":false}},"elements":[]},{"id":"cad03","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 0.95rem; line-height: 1.8; color: #4A5568; text-align: center;\">Not every project arrives with a complete, production-ready CAD file. Our design team works with engineers, product developers, and procurement teams at every stage of the design process.</p>","align":"center"},"elements":[]}],"isInner":false},{"id":"cad04","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":1100},"flex_direction":"row","flex_wrap":"wrap","flex_gap":{"unit":"px","size":20,"column":"20","row":"20","isLinked":true},"padding":{"unit":"px","top":"28","right":"40","bottom":"48","left":"40","isLinked":false},"background_background":"classic","background_color":"#F8FAFC"},"elements":[{"id":"cad05","elType":"widget","widgetType":"html","settings":{"html":"<div style=\"display:grid; grid-template-columns: repeat(2, 1fr); gap: 20px;\">\n  <div class=\"cad-service-card\">\n    <h4>Concept-to-CAD</h4>\n    <p>Have an idea, sketch, or reference sample but no digital file? Our team develops a manufacturable 3D CAD model from scratch &mdash; built with your target manufacturing process and material in mind from the start.</p>\n  </div>\n  <div class=\"cad-service-card\">\n    <h4>CAD File Preparation</h4>\n    <p>Have an existing CAD file? We review it for manufacturability and prepare it for your chosen process &mdash; CNC machining, thermoforming, laser cutting, injection molding, or another capability in our facility.</p>\n  </div>\n  <div class=\"cad-service-card\">\n    <h4>DFM Review</h4>\n    <p>Design for Manufacturability review evaluates your part against the constraints of your manufacturing process. We review wall thickness, draft angles, radii, tolerances, and material selection &mdash; flagging issues and recommending changes that reduce cost and improve quality.</p>\n  </div>\n  <div class=\"cad-service-card\">\n    <h4>Iteration Support</h4>\n    <p>As prototype testing reveals improvements, we support rapid design iteration &mdash; updating CAD files and turning around revised prototypes quickly so your development cycle keeps moving.</p>\n  </div>\n</div>\n<p style=\"font-family:'Lora',serif; font-size:0.88rem; color:#666; line-height:1.7; text-align:center; margin-top:20px;\"><strong style=\"color:#03325e;\">File formats accepted:</strong> STEP, IGES, SolidWorks (.sldprt/.sldasm), AutoCAD (.dwg/.dxf), PDF for 2D reference. Contact us if your format is not listed.</p>"},"elements":[]}],"isInner":false},{"id":"rp01","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":800},"flex_direction":"column","padding":{"unit":"px","top":"56","right":"40","bottom":"20","left":"40","isLinked":false},"background_background":"classic","background_color":"#FFFFFF","border_border":"solid","border_width":{"unit":"px","top":"1","right":"0","bottom":"0","left":"0","isLinked":false},"border_color":"#E2E8F0"},"elements":[{"id":"rp02","elType":"widget","widgetType":"heading","settings":{"title":"Rapid Prototyping Methods at Plastic-Craft","header_size":"h2","align":"center","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.8},"typography_font_weight":"700","_margin":{"unit":"px","top":"0","right":"0","bottom":"10","left":"0","isLinked":false}},"elements":[]},{"id":"rp03","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 0.95rem; line-height: 1.8; color: #4A5568; text-align: center;\">We produce prototypes using the same equipment and processes used for production &mdash; which means your prototype is made in the actual material and process your final parts will use, not a simulation of it.</p>","align":"center"},"elements":[]}],"isInner":false},{"id":"rp04","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":800},"flex_direction":"column","padding":{"unit":"px","top":"28","right":"40","bottom":"48","left":"40","isLinked":false},"background_background":"classic","background_color":"#FFFFFF"},"elements":[{"id":"rp05","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 0.95rem; line-height: 1.8; color: #4A5568;\"><strong style=\"color:#03325e;\">CNC Machined Prototypes</strong> &mdash; Prototypes machined directly from solid plastic or metal stock. The preferred method when dimensional accuracy, surface finish, and true material properties are critical. Available in virtually all plastics in our portfolio plus metal.</p><p style=\"font-family: 'Lora', serif; font-size: 0.95rem; line-height: 1.8; color: #4A5568; margin-top:14px;\"><strong style=\"color:#03325e;\">Thermoformed Prototypes</strong> &mdash; For parts destined for thermoformed production, prototype tooling is fabricated quickly at lower cost than production hard tooling &mdash; enabling accurate prototype parts in the actual forming process and material.</p><p style=\"font-family: 'Lora', serif; font-size: 0.95rem; line-height: 1.8; color: #4A5568; margin-top:14px;\"><strong style=\"color:#03325e;\">Laser Cut & Fabricated Prototypes</strong> &mdash; Flat and near-flat parts &mdash; panels, brackets, enclosures, templates &mdash; prototyped rapidly using laser cutting and secondary fabrication. Fast turnaround and low cost for flat-profile designs.</p><p style=\"font-family: 'Lora', serif; font-size: 0.95rem; line-height: 1.8; color: #4A5568; margin-top:14px;\"><strong style=\"color:#03325e;\">Assembled Prototype Sub-Systems</strong> &mdash; When a project involves multiple components &mdash; plastic parts, metal hardware, fasteners, adhesive bonds &mdash; we prototype the full assembly, not just individual parts.</p>","align":"left"},"elements":[]}],"isInner":false},{"id":"mat01","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":800},"flex_direction":"column","flex_align_items":"center","padding":{"unit":"px","top":"48","right":"40","bottom":"48","left":"40","isLinked":false},"background_background":"classic","background_color":"#F8FAFC","border_border":"solid","border_width":{"unit":"px","top":"1","right":"0","bottom":"0","left":"0","isLinked":false},"border_color":"#E2E8F0"},"elements":[{"id":"mat02","elType":"widget","widgetType":"heading","settings":{"title":"Prototype Materials Available","header_size":"h2","align":"center","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.8},"typography_font_weight":"700","_margin":{"unit":"px","top":"0","right":"0","bottom":"14","left":"0","isLinked":false}},"elements":[]},{"id":"mat03","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 0.95rem; color: #4A5568; line-height: 1.8; text-align: center;\">All 21 plastics in our portfolio are available for prototype production, including:</p><p style=\"font-family: 'Lora', serif; font-size: 0.92rem; color: #4A5568; line-height: 1.8; text-align: center; margin-top: 10px;\">Acrylic (PMMA), Polycarbonate (PC), Acetal/Delrin (POM), Nylon (PA), UHMW Polyethylene, Polyethylene (PE), HDPE, PVC, Phenolic, Hydlar Z (Kevlar-filled Nylon), Noryl (PPO), PEEK, PETG, Polypropylene (PP), Polystyrene (PS), Polyurethane (PU), Teflon (PTFE), Torlon (PAI), Ultem (PEI), Vinyl, Vespel (PI)</p><p style=\"font-family: 'Lora', serif; font-size: 0.88rem; color: #666; line-height: 1.7; text-align: center; font-style: italic; margin-top: 14px;\">Metal prototypes are also available. Contact us to discuss your alloy and specification requirements.</p>","align":"center"},"elements":[]}],"isInner":false},{"id":"ptp01","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":800},"flex_direction":"column","flex_align_items":"center","padding":{"unit":"px","top":"56","right":"40","bottom":"48","left":"40","isLinked":false},"background_background":"classic","background_color":"#FFFFFF","border_border":"solid","border_width":{"unit":"px","top":"1","right":"0","bottom":"0","left":"0","isLinked":false},"border_color":"#E2E8F0"},"elements":[{"id":"ptp02","elType":"widget","widgetType":"heading","settings":{"title":"From Prototype to Production","header_size":"h2","align":"center","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.8},"typography_font_weight":"700","_margin":{"unit":"px","top":"0","right":"0","bottom":"14","left":"0","isLinked":false}},"elements":[]},{"id":"ptp03","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 0.95rem; line-height: 1.8; color: #4A5568; text-align: center;\">One of the most significant advantages of prototyping with Plastic-Craft is that your prototype and your production parts come from the same facility, using the same equipment and the same team. There is no handoff to a separate production supplier &mdash; no re-quoting, no re-tooling surprises, no material substitutions.</p><p style=\"font-family: 'Lora', serif; font-size: 0.95rem; line-height: 1.8; color: #4A5568; text-align: center; margin-top: 14px;\">When your design is validated and approved, production scales up within our existing workflow. This continuity reduces lead time and eliminates the quality and tolerance variations that can occur when switching manufacturing partners between development and production phases.</p>","align":"center"},"elements":[]}],"isInner":false},{"id":"app01","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":1200},"flex_direction":"row","flex_wrap":"wrap","flex_gap":{"unit":"px","size":40,"column":"40","row":"0","isLinked":false},"padding":{"unit":"px","top":"56","right":"40","bottom":"56","left":"40","isLinked":false},"background_background":"classic","background_color":"#F8FAFC","border_border":"solid","border_width":{"unit":"px","top":"1","right":"0","bottom":"0","left":"0","isLinked":false},"border_color":"#E2E8F0"},"elements":[{"id":"app02","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_justify_content":"center","flex_align_items":"center","width":{"unit":"%","size":30},"min_height":{"unit":"px","size":380},"border_radius":{"unit":"px","top":"6","right":"6","bottom":"6","left":"6","isLinked":true},"overflow":"hidden"},"elements":[{"id":"app03","elType":"widget","widgetType":"image","settings":{"image":{"url":"https://plastic-craft.com/wp-content/uploads/2026/03/3dappplication.jpg","id":"","size":""},"image_size":"full","width":{"unit":"%","size":100},"height":{"unit":"%","size":100},"object-fit":"cover","_css_classes":"applications-image"},"elements":[]}],"isInner":true},{"id":"app04","elType":"container","settings":{"content_width":"full","flex_direction":"column","width":{"unit":"%","size":65}},"elements":[{"id":"app05","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p class=\"cad-section-label\">APPLICATIONS</p>","_margin":{"unit":"px","top":"0","right":"0","bottom":"8","left":"0","isLinked":false}},"elements":[]},{"id":"app06","elType":"widget","widgetType":"heading","settings":{"title":"Applications","header_size":"h2","align":"left","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.8},"typography_font_weight":"700","_margin":{"unit":"px","top":"0","right":"0","bottom":"16","left":"0","isLinked":false}},"elements":[]},{"id":"app07","elType":"widget","widgetType":"html","settings":{"html":"<ul style=\"list-style:none; padding:0;\">\n<li style=\"font-family:'Lora',serif; font-size:0.92rem; color:#666; line-height:1.65; padding:7px 0 7px 22px; position:relative;\"><span style=\"position:absolute;left:0;top:14px;width:8px;height:8px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">New product development</strong> &mdash; Physical validation of CAD designs before committing to production tooling</li>\n<li style=\"font-family:'Lora',serif; font-size:0.92rem; color:#666; line-height:1.65; padding:7px 0 7px 22px; position:relative;\"><span style=\"position:absolute;left:0;top:14px;width:8px;height:8px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Engineering verification</strong> &mdash; Functional testing under real load, temperature, and environmental conditions</li>\n<li style=\"font-family:'Lora',serif; font-size:0.92rem; color:#666; line-height:1.65; padding:7px 0 7px 22px; position:relative;\"><span style=\"position:absolute;left:0;top:14px;width:8px;height:8px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Fit and form checks</strong> &mdash; Assembly fit-up, clearance verification, and ergonomic evaluation</li>\n<li style=\"font-family:'Lora',serif; font-size:0.92rem; color:#666; line-height:1.65; padding:7px 0 7px 22px; position:relative;\"><span style=\"position:absolute;left:0;top:14px;width:8px;height:8px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Design iteration</strong> &mdash; Rapid revision and re-prototyping as testing reveals improvements</li>\n<li style=\"font-family:'Lora',serif; font-size:0.92rem; color:#666; line-height:1.65; padding:7px 0 7px 22px; position:relative;\"><span style=\"position:absolute;left:0;top:14px;width:8px;height:8px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Pre-production samples</strong> &mdash; Customer approval samples, regulatory submissions, and trade show samples</li>\n<li style=\"font-family:'Lora',serif; font-size:0.92rem; color:#666; line-height:1.65; padding:7px 0 7px 22px; position:relative;\"><span style=\"position:absolute;left:0;top:14px;width:8px;height:8px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Bridge production</strong> &mdash; Low-volume runs to fulfill early orders while production tooling is completed</li>\n<li style=\"font-family:'Lora',serif; font-size:0.92rem; color:#666; line-height:1.65; padding:7px 0 7px 22px; position:relative;\"><span style=\"position:absolute;left:0;top:14px;width:8px;height:8px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Replacement & legacy parts</strong> &mdash; One-off or small-run reproductions of discontinued or hard-to-source parts</li>\n</ul>"},"elements":[]},{"id":"app08","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 0.95rem; color: #666; line-height: 1.7; margin-top: 12px;\">Have a prototype project? <a href=\"/request-a-quote/\" style=\"color:#1380da; font-weight:600; text-decoration:none; border-bottom:2px solid #1380da;\">Request a Quote</a></p>","align":"left"},"elements":[]}],"isInner":true}],"isInner":false},{"id":"gal001","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":1200},"flex_direction":"row","flex_gap":{"unit":"px","size":12,"column":"12","row":"12","isLinked":true},"padding":{"unit":"px","top":"30","right":"40","bottom":"0","left":"40","isLinked":false}},"elements":[{"id":"gal002","elType":"container","settings":{"content_width":"full","width":{"unit":"%","size":19},"min_height":{"unit":"px","size":160},"border_radius":{"unit":"px","top":"6","right":"6","bottom":"6","left":"6","isLinked":true},"overflow":"hidden","background_background":"classic","background_color":"#E8EDF2"},"elements":[{"id":"gal003","elType":"widget","widgetType":"image","settings":{"image":{"url":"","