{"content":[{"id":"a1b2c3d","elType":"container","settings":{"content_width":"full","min_height":{"unit":"vw","size":27.5},"flex_direction":"column","flex_justify_content":"center","flex_align_items":"flex-start","background_background":"classic","background_image":{"url":"https://plastic-craft.com/wp-content/uploads/2026/03/Firefly_GeminiFlash_please-clean-up-this-image-967051.webp","id":"","size":""},"background_position":"center center","background_size":"cover","background_overlay_background":"gradient","background_overlay_color":"rgba(0,0,0,0.55)","background_overlay_color_b":"transparent","background_overlay_gradient_type":"linear","background_overlay_gradient_angle":{"unit":"deg","size":90},"padding":{"unit":"px","top":"80","right":"40","bottom":"80","left":"40","isLinked":false}},"elements":[{"id":"e4f5a6b","elType":"widget","widgetType":"heading","settings":{"title":"Capabilities","header_size":"h1","align":"left","title_color":"#FFFFFF","typography_typography":"custom","typography_font_family":"Montserrat","typography_font_size":{"unit":"rem","size":3},"typography_font_weight":"700","typography_text_transform":"uppercase","typography_letter_spacing":{"unit":"px","size":3},"text_shadow_text_shadow":{"horizontal":0,"vertical":2,"blur":16,"color":"rgba(0,0,0,0.6)"}},"elements":[]}],"isInner":false},{"id":"b7c8d9e","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":760},"flex_direction":"column","flex_align_items":"center","padding":{"unit":"px","top":"56","right":"40","bottom":"56","left":"40","isLinked":false}},"elements":[{"id":"f0a1b2c","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 1.1rem; line-height: 1.85; color: #4A5568; text-align: center;\">Plastic-Craft is a full-service plastics fabrication and distribution company based in West Nyack, NY. Our skilled team and high-tech facility can machine, rout, mill, and custom-fabricate plastic parts to your exact specifications. We deliver precision results for industries nationwide.</p><p style=\"font-family: 'Lora', serif; font-size: 1.1rem; line-height: 1.85; color: #4A5568; text-align: center;\">We offer a complete range of custom plastic fabrication services, using advanced CNC machinery, forming equipment, and finishing techniques to meet your exact needs. Explore our capabilities below and request a quote to start your project.</p>","align":"center"},"elements":[]}],"isInner":false},{"id":"c3d4e5f","elType":"container","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"d6e7f8a","elType":"widget","widgetType":"html","settings":{"html":"<style>\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Alice&family=Montserrat:wght@300;400;500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');\n\n@font-face {\n  font-family: 'Peace Sans';\n  src: url('../fonts/PeaceSans.woff2') format('woff2'),\n       url('../fonts/PeaceSans.woff')  format('woff');\n  font-weight: normal;\n  font-style: normal;\n  font-display: swap;\n}\n\n:root {\n  --color-primary:        #1380da;\n  --color-primary-light:  #64b7f0;\n  --color-primary-pale:   #d0e9fd;\n  --color-primary-bright: #2e8eff;\n  --color-accent-blue:    #031aec;\n  --color-accent-indigo:  #0b108b;\n  --color-navy:           #07276e;\n  --color-navy-deep:      #03325e;\n  --color-white:          #ffffff;\n  --color-gray:           #666666;\n  --color-gray-blue:      #83b1d1;\n  --color-gray-light:     #d4e1ed;\n  --font-title:      'Peace Sans', 'Montserrat', 'Arial Black', sans-serif;\n  --font-subtitle:   'Playfair Display', Georgia, serif;\n  --font-heading:    'Playfair Display', Georgia, serif;\n  --font-subheading: 'Lora', 'Garamond', 'Times New Roman', serif;\n  --font-section:    'Alice', 'Playfair Display', Georgia, serif;\n  --font-body:       'Lora', Georgia, serif;\n  --font-ui:         'Montserrat', sans-serif;\n  --space-xs:  0.5rem;\n  --space-sm:  1rem;\n  --space-md:  1.5rem;\n  --space-lg:  2.5rem;\n  --space-xl:  4rem;\n  --space-2xl: 6rem;\n  --max-width:    1200px;\n  --border-radius: 6px;\n  --shadow-sm:  0 1px 3px rgba(3, 50, 94, 0.08);\n  --shadow-md:  0 4px 12px rgba(3, 50, 94, 0.12);\n  --shadow-lg:  0 8px 30px rgba(3, 50, 94, 0.16);\n}\n\n/* ============================================================\n   CAPABILITIES PAGE STYLES\n   ============================================================ */\n\n.capabilities-wrapper {\n  padding: 20px 0 40px;\n  background: var(--color-white);\n}\n\n.cap {\n  position: relative;\n  max-width: var(--max-width);\n  margin: 0 auto 50px;\n  padding: 0 40px;\n}\n\n.cap-row {\n  display: flex;\n  height: 280px;\n  border-radius: var(--border-radius);\n  overflow: hidden;\n  box-shadow: var(--shadow-sm);\n}\n\n.cap-bg {\n  width: 55%;\n  background: var(--color-primary-pale);\n  flex-shrink: 0;\n}\n\n.cap-img {\n  width: 45%;\n  flex-shrink: 0;\n  overflow: hidden;\n}\n\n.cap-img img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n\n.cap-img .img-placeholder {\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(135deg, var(--color-primary-pale) 0%, var(--color-gray-light) 100%);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n}\n\n.img-placeholder svg {\n  width: 28px;\n  height: 28px;\n  color: var(--color-navy);\n  opacity: 0.25;\n}\n\n.img-placeholder span {\n  font-family: var(--font-ui);\n  font-size: 10px;\n  font-weight: 500;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n  color: var(--color-navy);\n  opacity: 0.3;\n}\n\n.cap.flip .cap-row {\n  flex-direction: row-reverse;\n}\n\n.cap-text {\n  position: absolute;\n  bottom: 24px;\n  width: 48%;\n  background: var(--color-white);\n  padding: 24px 28px;\n  border-radius: var(--border-radius);\n  box-shadow: var(--shadow-md);\n  z-index: 2;\n  border-top: 3px solid var(--color-primary);\n}\n\n.cap .cap-text {\n  left: 60px;\n}\n\n.cap.flip .cap-text {\n  left: auto;\n  right: 60px;\n}\n\n.cap-text h3 {\n  font-family: var(--font-heading);\n  font-size: 1.2rem;\n  font-weight: 700;\n  color: var(--color-navy-deep);\n  line-height: 1.3;\n  margin-bottom: 10px;\n}\n\n.cap-text p {\n  font-family: var(--font-body);\n  font-size: 0.92rem;\n  color: var(--color-gray);\n  line-height: 1.7;\n  margin-bottom: 14px;\n}\n\n.cap-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-family: var(--font-ui);\n  font-size: 0.75rem;\n  font-weight: 600;\n  letter-spacing: 1.2px;\n  text-transform: uppercase;\n  color: var(--color-primary);\n  border-bottom: 2px solid var(--color-primary);\n  padding-bottom: 2px;\n  transition: color 0.3s ease, border-color 0.3s ease;\n  text-decoration: none;\n}\n\n.cap-link:hover {\n  color: var(--color-accent-blue);\n  border-color: var(--color-accent-blue);\n}\n\n.cap-link svg {\n  width: 12px;\n  height: 12px;\n  transition: transform 0.3s ease;\n}\n\n.cap-link:hover svg {\n  transform: translateX(3px);\n}\n\n/* VENDOR CAROUSEL */\n.vendors {\n  padding: 50px 0;\n  background: var(--color-white);\n  overflow: hidden;\n}\n\n.vendors-label {\n  text-align: center;\n  font-family: var(--font-ui);\n  font-size: 0.75rem;\n  font-weight: 600;\n  letter-spacing: 2.5px;\n  text-transform: uppercase;\n  color: var(--color-gray-blue);\n  margin-bottom: 30px;\n}\n\n.vendor-track-wrapper {\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n}\n\n.vendor-track-wrapper::before,\n.vendor-track-wrapper::after {\n  content: '';\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 100px;\n  z-index: 2;\n  pointer-events: none;\n}\n\n.vendor-track-wrapper::before {\n  left: 0;\n  background: linear-gradient(90deg, var(--color-white), transparent);\n}\n\n.vendor-track-wrapper::after {\n  right: 0;\n  background: linear-gradient(270deg, var(--color-white), transparent);\n}\n\n.vendor-track {\n  display: flex;\n  gap: 60px;\n  align-items: center;\n  animation: vendorScroll 30s linear infinite;\n  width: max-content;\n}\n\n.vendor-logo {\n  flex-shrink: 0;\n  width: 140px;\n  height: 55px;\n  background: #f8fafc;\n  border: 1px solid var(--color-gray-light);\n  border-radius: var(--border-radius);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--font-ui);\n  font-size: 10px;\n  font-weight: 500;\n  color: var(--color-gray-blue);\n  opacity: 0.6;\n  transition: opacity 0.3s ease;\n}\n\n.vendor-logo:hover {\n  opacity: 1;\n}\n\n@keyframes vendorScroll {\n  0%   { transform: translateX(0); }\n  100% { transform: translateX(-50%); }\n}\n\n/* ANIMATIONS */\n.cap-fade {\n  opacity: 0;\n  transform: translateY(20px);\n  transition: opacity 0.6s ease, transform 0.6s ease;\n}\n\n.cap-fade.visible {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n/* RESPONSIVE */\n@media (max-width: 900px) {\n  .cap { padding: 0 24px; }\n  .cap-row { flex-direction: column !important; height: auto; }\n  .cap-bg { width: 100%; height: 60px; }\n  .cap-img { width: 100%; height: 200px; }\n  .cap-text {\n    position: relative;\n    width: 90%;\n    left: 5% !important;\n    right: auto !important;\n    bottom: auto;\n    margin-top: -30px;\n  }\n}\n\n@media (max-width: 600px) {\n  .cap-text h3 { font-size: 1rem; }\n  .cap-text { padding: 20px 22px; width: 94%; left: 3% !important; }\n}\n</style>\n\n<div class=\"capabilities-wrapper\">\n\n  <!-- 01: CNC Engraving -->\n  <div class=\"cap cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"cncEngraving\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>CNC Engraving</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>CNC Engraving</h3>\n      <p>CNC Engraving carves text, logos, and designs onto plastic surfaces with precision. Our machine accommodates sheets up to 38\" x 72\" for name plates, signage, branding, and more.</p>\n      <a href=\"https://plastic-craft.com/capabilities/cnc-engraving/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 02: CNC Routing -->\n  <div class=\"cap flip cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"cncRouting\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>CNC Routing</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>CNC Routing</h3>\n      <p>Computer-controlled routing cuts plastic into shapes from digital designs. Our three CNC Routing Centers, staffed by engineers, machinists, and programmers, deliver precision on every project.</p>\n      <a href=\"https://plastic-craft.com/capabilities/cnc-routing/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 03: CNC Milling & Turning -->\n  <div class=\"cap cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"cncMillingTurning\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>CNC Milling &amp; Turning</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>CNC Milling &amp; Turning</h3>\n      <p>Advanced machining methods that shape plastic by rotating or cutting material with tight tolerances. Our plastic-specific equipment ensures superior results for complex parts and assemblies.</p>\n      <a href=\"https://plastic-craft.com/capabilities/cnc-milling-turning/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 04: CNC Precision Cutting -->\n  <div class=\"cap flip cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"cncPrecisionCut\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>CNC Precision Cutting</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>CNC Precision Cutting</h3>\n      <p>Automated saws cut large plastic sheets up to 5\" thick with a tolerance of &plusmn;0.005\" &mdash; ideal for projects requiring exact measurements every time.</p>\n      <a href=\"https://plastic-craft.com/capabilities/cnc-precision-cutting/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 05: Laser Cutting & Waterjet Cutting -->\n  <div class=\"cap cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"laserWaterjet\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>Laser &amp; Waterjet Cutting</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>Laser Cutting &amp; Waterjet Cutting</h3>\n      <p>Two precision cutting methods for different needs. Laser cutting delivers intricate detail with clean edges, while waterjet cutting handles thicker materials without heat distortion.</p>\n      <a href=\"https://plastic-craft.com/capabilities/laser-waterjet-cutting/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 06: Drilling & Tapping -->\n  <div class=\"cap flip cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"drillingTapping\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>Drilling &amp; Tapping</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>Drilling &amp; Tapping</h3>\n      <p>Precision hole drilling and thread tapping for plastics and composites. We produce accurate, clean holes and threaded connections for assembly-ready parts.</p>\n      <a href=\"https://plastic-craft.com/capabilities/drilling-tapping/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 07: Sandblasting -->\n  <div class=\"cap cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"sandblasting\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>Sandblasting</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>Sandblasting</h3>\n      <p>High-pressure abrasive blasting creates a frosted or matte finish on plastic surfaces &mdash; ideal for giving your project a distinctive, professional look.</p>\n      <a href=\"https://plastic-craft.com/capabilities/sandblasting/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 08: Thermoforming -->\n  <div class=\"cap flip cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"thermoforming\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>Thermoforming</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>Thermoforming</h3>\n      <p>Heat softens plastic sheets which are then shaped over a mold. Ideal for packaging trays, containers, clamshell packaging, and custom-formed components.</p>\n      <a href=\"https://plastic-craft.com/capabilities/thermoforming/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 09: Vacuum & Heat Forming -->\n  <div class=\"cap cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"vacuumHeatForming\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>Vacuum &amp; Heat Forming</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>Vacuum &amp; Heat Forming</h3>\n      <p>Heats thermoplastic sheets and shapes them over molds using suction. Works on most thermoplastics, forming oversized pieces and domes up to 40\" in diameter.</p>\n      <a href=\"https://plastic-craft.com/capabilities/vacuum-heat-forming/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 10: Molding Services -->\n  <div class=\"cap flip cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"moldingServices\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>Molding Services</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>Molding Services</h3>\n      <p>Injection molding and custom molding for high-volume production of identical plastic parts. Melted plastic is pushed into a mold and cooled to form solid shapes &mdash; fast, repeatable, and cost-effective.</p>\n      <a href=\"https://plastic-craft.com/capabilities/molding-services/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 11: Custom Extrusion -->\n  <div class=\"cap cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"customExtrusion\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>Custom Extrusion</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>Custom Extrusion</h3>\n      <p>Plastic extrusion pushes heated material through a custom die to create continuous shapes like tubes, channels, and profiles. Ideal for custom cross-sections in production quantities.</p>\n      <a href=\"https://plastic-craft.com/capabilities/custom-extrusion/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 12: Printing & Marking -->\n  <div class=\"cap flip cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"printingMarking\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>Printing &amp; Marking</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>Printing &amp; Marking</h3>\n      <p>UV flatbed printing, pad printing, silk screening, and laser marking &mdash; multiple methods for applying high-resolution graphics, text, and branding directly onto plastic substrates.</p>\n      <a href=\"https://plastic-craft.com/capabilities/printing-marking/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 13: Edge Finishing & Line Bending -->\n  <div class=\"cap cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"edgeFinishing\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>Edge Finishing &amp; Line Bending</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>Edge Finishing &amp; Line Bending</h3>\n      <p>Edge polishing, beveling, and precision line bending for clean, professional edges and controlled bends. Essential for display cases, signage, and architectural applications.</p>\n      <a href=\"https://plastic-craft.com/capabilities/edge-finishing-line-bending/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 14: Coatings & Surface Finishes -->\n  <div class=\"cap flip cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"coatingsFinishes\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>Coatings &amp; Finishes</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>Coatings &amp; Surface Finishes</h3>\n      <p>Powder coating, specialty coatings, and annealing services to enhance durability, appearance, and performance. Includes MIL-spec CARC coatings for defense applications.</p>\n      <a href=\"https://plastic-craft.com/capabilities/coatings-finishes/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 15: Welding & Bonding -->\n  <div class=\"cap cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"weldingBonding\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>Welding &amp; Bonding</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>Welding &amp; Bonding</h3>\n      <p>Plastic welding, solvent bonding, adhesive bonding, and cryogenic deburring. Multiple joining methods to create strong, seamless connections between plastic components.</p>\n      <a href=\"https://plastic-craft.com/capabilities/welding-bonding/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 16: CAD Design & Rapid Prototyping -->\n  <div class=\"cap flip cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"cadPrototyping\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>CAD Design &amp; Prototyping</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>CAD Design &amp; Rapid Prototyping</h3>\n      <p>Our engineers use industry-standard CAD software to design parts with exacting precision, then produce rapid prototypes so you can validate form, fit, and function before full production.</p>\n      <a href=\"https://plastic-craft.com/capabilities/cad-design-prototyping/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 17: Assembly & Inspection -->\n  <div class=\"cap cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"assemblyInspection\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>Assembly &amp; Inspection</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>Assembly &amp; Inspection</h3>\n      <p>Full electromechanical assembly services paired with Zeiss CMM inspection for verified dimensional accuracy. Every part leaves our facility meeting your exact specifications.</p>\n      <a href=\"https://plastic-craft.com/capabilities/assembly-inspection/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n  <!-- 18: Metal Fabrication Services -->\n  <div class=\"cap flip cap-fade\">\n    <div class=\"cap-row\">\n      <div class=\"cap-bg\"></div>\n      <div class=\"cap-img\" data-img=\"metalFabrication\"><div class=\"img-placeholder\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"M21 15l-5-5L5 21\"/></svg><span>Metal Fabrication</span></div></div>\n    </div>\n    <div class=\"cap-text\">\n      <h3>Metal Fabrication Services</h3>\n      <p>Complete metal fabrication including welding, stamping, press brake bending, turret punching, sheet fabrication, heat treating, cold forming, and plating for integrated project solutions.</p>\n      <a href=\"https://plastic-craft.com/capabilities/metal-fabrication/\" class=\"cap-link\">Learn More <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>\n    </div>\n  </div>\n\n</div>"},"elements":[]}],"isInner":false},{"id":"g9h0i1j","elType":"container","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"k2l3m4n","elType":"widget","widgetType":"html","settings":{"html":"<section class=\"vendors\">\n  <div class=\"vendors-label\">Trusted Suppliers &amp; Partners</div>\n  <div class=\"vendor-track-wrapper\">\n    <div class=\"vendor-track\">\n      <div class=\"vendor-logo\"><img src=\"https://plastic-craft.com/wp-content/uploads/2025/08/logomacys.webp\" alt=\"Macy's\" style=\"max-width:100%;max-height:100%;object-fit:contain\"></div><div class=\"vendor-logo\"><img src=\"https://plastic-craft.com/wp-content/uploads/2025/08/logotoyota.webp\" alt=\"Toyota\" style=\"max-width:100%;max-height:100%;object-fit:contain\"></div><div class=\"vendor-logo\"><img src=\"https://plastic-craft.com/wp-content/uploads/2025/08/logomitsubishichem.webp\" alt=\"Mitsubishi Chemical\" style=\"max-widt