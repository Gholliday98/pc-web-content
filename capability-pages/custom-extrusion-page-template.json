{"content":[{"id":"hero001","elType":"container","settings":{"content_width":"full","min_height":{"unit":"vw","size":30},"flex_direction":"column","flex_justify_content":"flex-end","flex_align_items":"flex-start","background_background":"classic","background_image":{"url":"https://plastic-craft.com/wp-content/uploads/2026/03/extrusion.webp","id":"","size":""},"background_position":"center center","background_size":"cover","background_overlay_background":"gradient","background_overlay_color":"rgba(0,0,0,0.50)","background_overlay_color_b":"transparent","background_overlay_gradient_type":"linear","background_overlay_gradient_angle":{"unit":"deg","size":0},"padding":{"unit":"px","top":"80","right":"60","bottom":"60","left":"60","isLinked":false}},"elements":[{"id":"hero002","elType":"widget","widgetType":"heading","settings":{"title":"Custom Plastic Extrusion Services","header_size":"h1","align":"left","title_color":"#FFFFFF","typography_typography":"custom","typography_font_family":"Montserrat","typography_font_size":{"unit":"rem","size":3.2},"typography_font_weight":"700","typography_text_transform":"uppercase","typography_letter_spacing":{"unit":"px","size":4},"text_shadow_text_shadow":{"horizontal":0,"vertical":2,"blur":20,"color":"rgba(0,0,0,0.7)"}},"elements":[]},{"id":"hero003","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 1.15rem; line-height: 1.6; color: rgba(255,255,255,0.9); max-width: 680px;\">Custom-profile and standard-shape plastic extrusion in a broad range of thermoplastics &mdash; rod, tube, sheet, and complex custom profiles produced to your specifications.</p>","_margin":{"unit":"px","top":"12","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[]}],"isInner":false},{"id":"css001","elType":"container","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"css002","elType":"widget","widgetType":"html","settings":{"html":"<style>\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Alice&family=Montserrat:wght@300;400;500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');\n\n:root {\n  --color-primary:        #1380da;\n  --color-primary-light:  #64b7f0;\n  --color-primary-pale:   #d0e9fd;\n  --color-primary-bright: #2e8eff;\n  --color-accent-blue:    #031aec;\n  --color-accent-indigo:  #0b108b;\n  --color-navy:           #07276e;\n  --color-navy-deep:      #03325e;\n  --color-white:          #ffffff;\n  --color-gray:           #666666;\n  --color-gray-blue:      #83b1d1;\n  --color-gray-light:     #d4e1ed;\n  --font-heading:    'Playfair Display', Georgia, serif;\n  --font-body:       'Lora', Georgia, serif;\n  --font-ui:         'Montserrat', sans-serif;\n  --max-width:       1200px;\n  --border-radius:   6px;\n  --shadow-sm:  0 1px 3px rgba(3,50,94,0.08);\n  --shadow-md:  0 4px 12px rgba(3,50,94,0.12);\n  --shadow-lg:  0 8px 30px rgba(3,50,94,0.16);\n}\n\n/* \u2500\u2500 TABLES \u2500\u2500 */\n.ext-compare-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-family: var(--font-body);\n  font-size: 0.9rem;\n}\n\n.ext-compare-table thead th {\n  font-family: var(--font-ui);\n  font-size: 0.78rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  color: var(--color-navy-deep);\n  background: var(--color-primary-pale);\n  padding: 14px 18px;\n  text-align: left;\n  border-bottom: 2px solid var(--color-primary);\n}\n\n.ext-compare-table tbody td {\n  padding: 14px 18px;\n  color: var(--color-gray);\n  line-height: 1.6;\n  border-bottom: 1px solid var(--color-gray-light);\n}\n\n.ext-compare-table tbody td:first-child {\n  font-family: var(--font-ui);\n  font-weight: 600;\n  color: var(--color-navy-deep);\n  white-space: nowrap;\n}\n\n.ext-compare-table tbody tr:last-child td {\n  border-bottom: none;\n}\n\n.ext-compare-table tbody tr:hover {\n  background: #f8fafc;\n}\n\n/* \u2500\u2500 SECTION DIVIDER \u2500\u2500 */\n.ext-section-label {\n  font-family: var(--font-ui);\n  font-size: 0.85rem;\n  font-weight: 700;\n  color: #1380da;\n  text-transform: uppercase;\n  letter-spacing: 1.5px;\n}\n\n/* \u2500\u2500 FAQ STYLES \u2500\u2500 */\n.faq-item {\n  border-bottom: 1px solid var(--color-gray-light);\n  padding: 24px 0;\n}\n\n.faq-item:last-child { border-bottom: none; }\n\n.faq-q {\n  font-family: var(--font-ui);\n  font-size: 1rem;\n  font-weight: 600;\n  color: var(--color-navy-deep);\n  cursor: pointer;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 16px;\n}\n\n.faq-q::after {\n  content: '+';\n  font-size: 1.3rem;\n  font-weight: 300;\n  color: var(--color-primary);\n  transition: transform 0.3s;\n  flex-shrink: 0;\n}\n\n.faq-item.open .faq-q::after { content: '\\2212'; }\n\n.faq-a {\n  max-height: 0;\n  overflow: hidden;\n  transition: max-height 0.4s ease, padding 0.3s ease;\n  padding-top: 0;\n}\n\n.faq-item.open .faq-a {\n  max-height: 600px;\n  padding-top: 14px;\n}\n\n.faq-a p {\n  font-family: var(--font-body);\n  font-size: 0.92rem;\n  color: var(--color-gray);\n  line-height: 1.75;\n}\n\n/* \u2500\u2500 SCROLL ANIMATIONS \u2500\u2500 */\n.cap-page-fade {\n  opacity: 0;\n  transform: translateY(20px);\n  transition: opacity 0.6s ease, transform 0.6s ease;\n}\n\n.cap-page-fade.visible {\n  opacity: 1;\n  transform: translateY(0);\n}\n</style>"},"elements":[]}],"isInner":false},{"id":"wis001","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":800},"flex_direction":"column","flex_align_items":"center","padding":{"unit":"px","top":"36","right":"40","bottom":"32","left":"40","isLinked":false},"background_background":"classic","background_color":"#FFFFFF"},"elements":[{"id":"wis002","elType":"widget","widgetType":"heading","settings":{"title":"What Is Plastic Extrusion?","header_size":"h2","align":"center","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.8},"typography_font_weight":"700","_margin":{"unit":"px","top":"0","right":"0","bottom":"14","left":"0","isLinked":false}},"elements":[]},{"id":"wis003","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 1.05rem; line-height: 1.85; color: #4A5568; text-align: center;\">Plastic extrusion is a continuous manufacturing process in which thermoplastic raw material &mdash; typically in pellet or granule form &mdash; is fed into a heated barrel where it is melted and then forced under pressure through a shaped die. The die determines the cross-sectional profile of the finished product. As the extrudate exits the die, it is cooled, dimensionally sized, and cut to length or coiled for delivery.</p><p style=\"font-family: 'Lora', serif; font-size: 1.05rem; line-height: 1.85; color: #4A5568; text-align: center;\">Because the process is continuous, extrusion is uniquely suited to producing parts where the cross-section is consistent along the entire length &mdash; profiles, channels, tubes, rods, strips, seals, and gasket shapes. This makes extrusion far more economical than machining for parts where consistent profile geometry is the primary requirement.</p><p style=\"font-family: 'Lora', serif; font-size: 1.05rem; line-height: 1.85; color: #4A5568; text-align: center;\"><strong style=\"color:#03325e;\">Profile Extrusion</strong> produces shapes with custom cross-sectional profiles &mdash; T-sections, L-sections, U-channels, complex multi-feature profiles &mdash; in continuous lengths. Custom tooling (the extrusion die) is fabricated to your profile geometry.</p><p style=\"font-family: 'Lora', serif; font-size: 1.05rem; line-height: 1.85; color: #4A5568; text-align: center;\"><strong style=\"color:#03325e;\">Standard Shape Extrusion</strong> produces round rod, rectangular bar, square bar, tube, and sheet in standard and custom dimensions. These are the building blocks of machined plastic parts &mdash; many of the engineering plastic stock shapes sold by plastic distributors are produced by extrusion.</p>","align":"center"},"elements":[]}],"isInner":false},{"id":"mat01","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":800},"flex_direction":"column","flex_align_items":"center","padding":{"unit":"px","top":"56","right":"40","bottom":"48","left":"40","isLinked":false},"background_background":"classic","background_color":"#F8FAFC","border_border":"solid","border_width":{"unit":"px","top":"1","right":"0","bottom":"0","left":"0","isLinked":false},"border_color":"#E2E8F0"},"elements":[{"id":"mat02","elType":"widget","widgetType":"heading","settings":{"title":"Materials Available for Extrusion","header_size":"h2","align":"center","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.8},"typography_font_weight":"700","_margin":{"unit":"px","top":"0","right":"0","bottom":"14","left":"0","isLinked":false}},"elements":[]},{"id":"mat03","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 0.95rem; color: #4A5568; line-height: 1.8; text-align: center;\">Acrylic (PMMA), Polycarbonate (PC), Nylon (PA), Polyethylene (PE), HDPE, UHMW Polyethylene, PVC, Noryl (PPO), PETG, Polypropylene (PP), Polystyrene (PS), Polyurethane (PU), Ultem (PEI), Vinyl</p><p style=\"font-family: 'Lora', serif; font-size: 0.92rem; color: #666; line-height: 1.75; text-align: center; font-style: italic; margin-top: 16px;\">High-performance materials including PEEK, Torlon, and Vespel are available in standard extruded stock shapes. Custom profile extrusion in these materials is available &mdash; contact us to discuss your requirements.</p>","align":"center"},"elements":[]}],"isInner":false},{"id":"cap01","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":1200},"flex_direction":"row","flex_wrap":"nowrap","flex_gap":{"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"40","bottom":"0","left":"40","isLinked":false},"overflow":"hidden","border_radius":{"unit":"px","top":"6","right":"6","bottom":"6","left":"6","isLinked":true},"margin":{"unit":"px","top":"40","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[{"id":"cap02","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_justify_content":"center","width":{"unit":"%","size":100},"background_background":"classic","background_color":"rgba(19,128,218,0.12)","padding":{"unit":"px","top":"40","right":"44","bottom":"40","left":"44","isLinked":false}},"elements":[{"id":"cap03","elType":"widget","widgetType":"heading","settings":{"title":"OUR EXTRUSION CAPABILITIES","header_size":"h3","title_color":"#1380da","typography_typography":"custom","typography_font_family":"Montserrat","typography_font_size":{"unit":"rem","size":0.7},"typography_font_weight":"700","typography_letter_spacing":{"unit":"px","size":2.5},"typography_text_transform":"uppercase"},"elements":[]},{"id":"cap04","elType":"widget","widgetType":"heading","settings":{"title":"Our Extrusion Capabilities","header_size":"h2","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.5},"typography_font_weight":"700","_margin":{"unit":"px","top":"10","right":"0","bottom":"14","left":"0","isLinked":false}},"elements":[]},{"id":"cap05","elType":"widget","widgetType":"text-editor","settings":{"editor":"<ul style=\"list-style:none; padding:0; margin-top:8px;\">\n<li style=\"font-family:'Lora',serif; font-size:0.88rem; color:#666; line-height:1.7; padding:4px 0 4px 18px; position:relative;\"><span style=\"position:absolute;left:0;top:12px;width:6px;height:6px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Custom profile extrusion</strong> &mdash; unique cross-sectional shapes produced from customer-supplied or Plastic-Craft designed tooling</li>\n<li style=\"font-family:'Lora',serif; font-size:0.88rem; color:#666; line-height:1.7; padding:4px 0 4px 18px; position:relative;\"><span style=\"position:absolute;left:0;top:12px;width:6px;height:6px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Standard shape extrusion</strong> &mdash; rod, bar, tube, and sheet in standard and custom dimensions</li>\n<li style=\"font-family:'Lora',serif; font-size:0.88rem; color:#666; line-height:1.7; padding:4px 0 4px 18px; position:relative;\"><span style=\"position:absolute;left:0;top:12px;width:6px;height:6px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Die design and tooling fabrication</strong> &mdash; extrusion die design and manufacture for new profile programs</li>\n<li style=\"font-family:'Lora',serif; font-size:0.88rem; color:#666; line-height:1.7; padding:4px 0 4px 18px; position:relative;\"><span style=\"position:absolute;left:0;top:12px;width:6px;height:6px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Co-extrusion</strong> &mdash; multiple materials or durometer zones extruded in a single profile (contact us to discuss your application)</li>\n<li style=\"font-family:'Lora',serif; font-size:0.88rem; color:#666; line-height:1.7; padding:4px 0 4px 18px; position:relative;\"><span style=\"position:absolute;left:0;top:12px;width:6px;height:6px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Cut-to-length service</strong> &mdash; continuous extrusion cut to your specified lengths</li>\n<li style=\"font-family:'Lora',serif; font-size:0.88rem; color:#666; line-height:1.7; padding:4px 0 4px 18px; position:relative;\"><span style=\"position:absolute;left:0;top:12px;width:6px;height:6px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Prototype and production quantities</strong> &mdash; from initial profile validation runs through volume production</li>\n</ul>","align":"left"},"elements":[]}],"isInner":true}],"isInner":false},{"id":"comp01","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":1000},"flex_direction":"column","flex_align_items":"center","padding":{"unit":"px","top":"56","right":"40","bottom":"56","left":"40","isLinked":false},"background_background":"classic","background_color":"#FFFFFF","border_border":"solid","border_width":{"unit":"px","top":"1","right":"0","bottom":"0","left":"0","isLinked":false},"border_color":"#E2E8F0"},"elements":[{"id":"comp02","elType":"widget","widgetType":"heading","settings":{"title":"Profile Extrusion vs. Injection Molding","header_size":"h2","align":"center","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.8},"typography_font_weight":"700","_margin":{"unit":"px","top":"0","right":"0","bottom":"28","left":"0","isLinked":false}},"elements":[]},{"id":"comp03","elType":"widget","widgetType":"html","settings":{"html":"<div style=\"overflow-x:auto;\"><table class=\"ext-compare-table\">\n  <thead>\n    <tr>\n      <th></th>\n      <th>Profile Extrusion</th>\n      <th>Injection Molding</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Part Geometry</td>\n      <td>Consistent cross-section, unlimited length</td>\n      <td>Complex 3D shapes, fixed length</td>\n    </tr>\n    <tr>\n      <td>Tooling Cost</td>\n      <td>Lower &mdash; extrusion die only</td>\n      <td>Higher &mdash; closed mold tool</td>\n    </tr>\n    <tr>\n      <td>Best For</td>\n      <td>Linear profiles, seals, channels, trim</td>\n      <td>Complex enclosed parts, housings</td>\n    </tr>\n    <tr>\n      <td>Length Flexibility</td>\n      <td>Continuous &mdash; cut to any length</td>\n      <td>Fixed &mdash; determined by mold cavity</td>\n    </tr>\n    <tr>\n      <td>Volume Efficiency</td>\n      <td>High for long continuous shapes</td>\n      <td>High for complex short parts</td>\n    </tr>\n  </tbody>\n</table></div>\n<p style=\"font-family: 'Lora', serif; font-size: 0.92rem; color: #666; line-height: 1.75; margin-top: 20px; text-align: center;\">If your part has a consistent cross-section and needs to be produced in lengths &mdash; rather than as a discrete short part &mdash; extrusion is typically the more economical choice. For complex three-dimensional parts, injection molding is the better fit. Plastic-Craft offers both, and can advise on the right process for your design.</p>"},"elements":[]}],"isInner":false},{"id":"app01","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":1200},"flex_direction":"row","flex_wrap":"wrap","flex_gap":{"unit":"px","size":40,"column":"40","row":"0","isLinked":false},"padding":{"unit":"px","top":"56","right":"40","bottom":"56","left":"40","isLinked":false},"background_background":"classic","background_color":"#F8FAFC","border_border":"solid","border_width":{"unit":"px","top":"1","right":"0","bottom":"0","left":"0","isLinked":false},"border_color":"#E2E8F0"},"elements":[{"id":"app02","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_justify_content":"center","flex_align_items":"center","width":{"unit":"%","size":30},"min_height":{"unit":"px","size":380},"border_radius":{"unit":"px","top":"6","right":"6","bottom":"6","left":"6","isLinked":true},"overflow":"hidden"},"elements":[{"id":"app03","elType":"widget","widgetType":"image","settings":{"image":{"url":"https://plastic-craft.com/wp-content/uploads/2026/03/customextrusion.jpg","id":"","size":""},"image_size":"full