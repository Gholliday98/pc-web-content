{"content":[{"id":"hero001","elType":"container","settings":{"content_width":"full","min_height":{"unit":"vw","size":30},"flex_direction":"column","flex_justify_content":"flex-end","flex_align_items":"flex-start","background_background":"classic","background_image":{"url":"https://plastic-craft.com/wp-content/uploads/2026/03/drilling.webp","id":"","size":""},"background_position":"center center","background_size":"cover","background_overlay_background":"gradient","background_overlay_color":"rgba(0,0,0,0.50)","background_overlay_color_b":"transparent","background_overlay_gradient_type":"linear","background_overlay_gradient_angle":{"unit":"deg","size":0},"padding":{"unit":"px","top":"80","right":"60","bottom":"60","left":"60","isLinked":false}},"elements":[{"id":"hero002","elType":"widget","widgetType":"heading","settings":{"title":"Drilling, Tapping & Perforation Services","header_size":"h1","align":"left","title_color":"#FFFFFF","typography_typography":"custom","typography_font_family":"Montserrat","typography_font_size":{"unit":"rem","size":3.2},"typography_font_weight":"700","typography_text_transform":"uppercase","typography_letter_spacing":{"unit":"px","size":4},"text_shadow_text_shadow":{"horizontal":0,"vertical":2,"blur":20,"color":"rgba(0,0,0,0.7)"}},"elements":[]},{"id":"hero003","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 1.15rem; line-height: 1.6; color: rgba(255,255,255,0.9); max-width: 680px;\">Precision hole drilling, thread tapping, and custom perforation patterns in plastic and metal &mdash; from single precision bores to high-density perforation arrays.</p>","_margin":{"unit":"px","top":"12","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[]}],"isInner":false},{"id":"css001","elType":"container","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"css002","elType":"widget","widgetType":"html","settings":{"html":"<style>\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Alice&family=Montserrat:wght@300;400;500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');\n\n:root {\n  --color-primary:        #1380da;\n  --color-primary-light:  #64b7f0;\n  --color-primary-pale:   #d0e9fd;\n  --color-primary-bright: #2e8eff;\n  --color-accent-blue:    #031aec;\n  --color-accent-indigo:  #0b108b;\n  --color-navy:           #07276e;\n  --color-navy-deep:      #03325e;\n  --color-white:          #ffffff;\n  --color-gray:           #666666;\n  --color-gray-blue:      #83b1d1;\n  --color-gray-light:     #d4e1ed;\n  --font-heading:    'Playfair Display', Georgia, serif;\n  --font-body:       'Lora', Georgia, serif;\n  --font-ui:         'Montserrat', sans-serif;\n  --max-width:       1200px;\n  --border-radius:   6px;\n  --shadow-sm:  0 1px 3px rgba(3,50,94,0.08);\n  --shadow-md:  0 4px 12px rgba(3,50,94,0.12);\n  --shadow-lg:  0 8px 30px rgba(3,50,94,0.16);\n}\n\n/* \u2500\u2500 PROCESS CARDS CAROUSEL \u2500\u2500 */\n.process-track-wrapper {\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n}\n\n.process-track-wrapper::before,\n.process-track-wrapper::after {\n  content: '';\n  position: absolute;\n  top: 0; bottom: 0;\n  width: 60px;\n  z-index: 2;\n  pointer-events: none;\n}\n\n.process-track-wrapper::before {\n  left: 0;\n  background: linear-gradient(90deg, var(--color-white), transparent);\n}\n\n.process-track-wrapper::after {\n  right: 0;\n  background: linear-gradient(270deg, var(--color-white), transparent);\n}\n\n.process-track {\n  display: flex;\n  gap: 24px;\n  padding: 10px 40px 20px;\n  overflow-x: auto;\n  scroll-snap-type: x mandatory;\n  -webkit-overflow-scrolling: touch;\n  scrollbar-width: thin;\n  scrollbar-color: var(--color-primary-pale) transparent;\n}\n\n.process-track::-webkit-scrollbar { height: 6px; }\n.process-track::-webkit-scrollbar-track { background: transparent; }\n.process-track::-webkit-scrollbar-thumb { background: var(--color-primary-pale); border-radius: 3px; }\n\n.process-card {\n  flex: 0 0 280px;\n  scroll-snap-align: start;\n  background: #f8fafc;\n  border: 1px solid var(--color-gray-light);\n  border-radius: var(--border-radius);\n  padding: 28px 24px;\n  transition: box-shadow 0.3s ease, transform 0.3s ease;\n}\n\n.process-card:hover {\n  box-shadow: var(--shadow-md);\n  transform: translateY(-3px);\n}\n\n.process-card .step-num {\n  display: inline-block;\n  width: 32px; height: 32px;\n  line-height: 32px;\n  text-align: center;\n  background: var(--color-primary);\n  color: #fff;\n  border-radius: 50%;\n  font-family: var(--font-ui);\n  font-size: 0.8rem;\n  font-weight: 700;\n  margin-bottom: 14px;\n}\n\n.process-card h4 {\n  font-family: var(--font-ui);\n  font-size: 0.95rem;\n  font-weight: 700;\n  color: var(--color-navy-deep);\n  margin-bottom: 10px;\n  line-height: 1.3;\n}\n\n.process-card p {\n  font-family: var(--font-body);\n  font-size: 0.85rem;\n  color: var(--color-gray);\n  line-height: 1.65;\n}\n\n.process-dots {\n  display: flex;\n  justify-content: center;\n  gap: 8px;\n  margin-top: 20px;\n}\n\n.process-dots span {\n  width: 8px; height: 8px;\n  border-radius: 50%;\n  background: var(--color-gray-light);\n  cursor: pointer;\n  transition: background 0.3s;\n}\n\n.process-dots span.active { background: var(--color-primary); }\n\n/* \u2500\u2500 CAPABILITY CARDS \u2500\u2500 */\n.dt-cap-card {\n  background: #f8fafc;\n  border: 1px solid var(--color-gray-light);\n  border-radius: var(--border-radius);\n  padding: 24px;\n  transition: box-shadow 0.3s ease, transform 0.3s ease;\n}\n\n.dt-cap-card:hover {\n  box-shadow: var(--shadow-md);\n  transform: translateY(-3px);\n}\n\n.dt-cap-card h4 {\n  font-family: var(--font-ui);\n  font-size: 0.9rem;\n  font-weight: 700;\n  color: var(--color-navy-deep);\n  margin-bottom: 8px;\n}\n\n.dt-cap-card p {\n  font-family: var(--font-body);\n  font-size: 0.85rem;\n  color: var(--color-gray);\n  line-height: 1.65;\n}\n\n/* \u2500\u2500 SECTION DIVIDER \u2500\u2500 */\n.dt-section-label {\n  font-family: var(--font-ui);\n  font-size: 0.85rem;\n  font-weight: 700;\n  color: #1380da;\n  text-transform: uppercase;\n  letter-spacing: 1.5px;\n}\n\n/* \u2500\u2500 FAQ STYLES \u2500\u2500 */\n.faq-item {\n  border-bottom: 1px solid var(--color-gray-light);\n  padding: 24px 0;\n}\n\n.faq-item:last-child { border-bottom: none; }\n\n.faq-q {\n  font-family: var(--font-ui);\n  font-size: 1rem;\n  font-weight: 600;\n  color: var(--color-navy-deep);\n  cursor: pointer;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 16px;\n}\n\n.faq-q::after {\n  content: '+';\n  font-size: 1.3rem;\n  font-weight: 300;\n  color: var(--color-primary);\n  transition: transform 0.3s;\n  flex-shrink: 0;\n}\n\n.faq-item.open .faq-q::after { content: '\\2212'; }\n\n.faq-a {\n  max-height: 0;\n  overflow: hidden;\n  transition: max-height 0.4s ease, padding 0.3s ease;\n  padding-top: 0;\n}\n\n.faq-item.open .faq-a {\n  max-height: 600px;\n  padding-top: 14px;\n}\n\n.faq-a p {\n  font-family: var(--font-body);\n  font-size: 0.92rem;\n  color: var(--color-gray);\n  line-height: 1.75;\n}\n\n/* \u2500\u2500 SCROLL ANIMATIONS \u2500\u2500 */\n.cap-page-fade {\n  opacity: 0;\n  transform: translateY(20px);\n  transition: opacity 0.6s ease, transform 0.6s ease;\n}\n\n.cap-page-fade.visible {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n/* \u2500\u2500 RESPONSIVE \u2500\u2500 */\n@media (max-width: 900px) {\n  .process-card { flex: 0 0 260px; }\n}\n\n@media (max-width: 600px) {\n  .process-card { flex: 0 0 240px; }\n}\n</style>"},"elements":[]}],"isInner":false},{"id":"wis001","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":800},"flex_direction":"column","flex_align_items":"center","padding":{"unit":"px","top":"36","right":"40","bottom":"32","left":"40","isLinked":false},"background_background":"classic","background_color":"#FFFFFF"},"elements":[{"id":"wis002","elType":"widget","widgetType":"heading","settings":{"title":"What Is Drilling, Tapping & Perforation?","header_size":"h2","align":"center","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.8},"typography_font_weight":"700","_margin":{"unit":"px","top":"0","right":"0","bottom":"14","left":"0","isLinked":false}},"elements":[]},{"id":"wis003","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 1.05rem; line-height: 1.85; color: #4A5568; text-align: center;\">Hole-making operations are among the most common secondary processes in plastic and metal fabrication. Whether you need a single precisely located bore, a complex pattern of tapped holes for fastener installation, or a full-sheet perforation array for filtration, ventilation, or weight reduction, Plastic-Craft has the equipment, tooling, and process knowledge to deliver accurate, clean results in a broad range of materials.</p><p style=\"font-family: 'Lora', serif; font-size: 1.05rem; line-height: 1.85; color: #4A5568; text-align: center;\">Our drilling, tapping, and perforation services support customers from prototype through production across industries including aerospace, medical, industrial equipment, and electronics.</p>","align":"center"},"elements":[]}],"isInner":false},{"id":"drill01","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":800},"flex_direction":"column","flex_align_items":"center","padding":{"unit":"px","top":"56","right":"40","bottom":"40","left":"40","isLinked":false},"background_background":"classic","background_color":"#F8FAFC","border_border":"solid","border_width":{"unit":"px","top":"1","right":"0","bottom":"0","left":"0","isLinked":false},"border_color":"#E2E8F0"},"elements":[{"id":"drill02","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p class=\"dt-section-label\" style=\"text-align:center;\">DRILLING</p>","align":"center","_margin":{"unit":"px","top":"0","right":"0","bottom":"8","left":"0","isLinked":false}},"elements":[]},{"id":"drill03","elType":"widget","widgetType":"heading","settings":{"title":"Precision Drilling","header_size":"h2","align":"center","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.8},"typography_font_weight":"700","_margin":{"unit":"px","top":"0","right":"0","bottom":"14","left":"0","isLinked":false}},"elements":[]},{"id":"drill04","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 1.0rem; line-height: 1.8; color: #4A5568; text-align: center;\">CNC-controlled drilling at Plastic-Craft delivers precisely located holes in plastic and metal parts to your dimensional specifications. Our drilling capabilities include:</p>","align":"center","_margin":{"unit":"px","top":"0","right":"0","bottom":"24","left":"0","isLinked":false}},"elements":[]}],"isInner":false},{"id":"drill05","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":1100},"flex_direction":"row","flex_wrap":"wrap","flex_gap":{"unit":"px","size":20,"column":"20","row":"20","isLinked":true},"padding":{"unit":"px","top":"0","right":"40","bottom":"40","left":"40","isLinked":false},"background_background":"classic","background_color":"#F8FAFC"},"elements":[{"id":"dc01","elType":"container","settings":{"content_width":"full","width":{"unit":"%","size":31},"_css_classes":"dt-cap-card"},"elements":[{"id":"dc02","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"dt-cap-card\" style=\"border:none;padding:0;\"><h4>Single &amp; Multi-Hole Drilling</h4><p>From individual precision bores to complex multi-hole patterns on CNC machining centers.</p></div>"},"elements":[]}],"isInner":true},{"id":"dc03","elType":"container","settings":{"content_width":"full","width":{"unit":"%","size":31},"_css_classes":"dt-cap-card"},"elements":[{"id":"dc04","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"dt-cap-card\" style=\"border:none;padding:0;\"><h4>Through Holes &amp; Blind Holes</h4><p>Full through-thickness or controlled-depth blind bores to your exact specifications.</p></div>"},"elements":[]}],"isInner":true},{"id":"dc05","elType":"container","settings":{"content_width":"full","width":{"unit":"%","size":31},"_css_classes":"dt-cap-card"},"elements":[{"id":"dc06","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"dt-cap-card\" style=\"border:none;padding:0;\"><h4>Close-Tolerance Hole Sizing</h4><p>Holes produced to tight diameter tolerances for interference, transition, or clearance fits.</p></div>"},"elements":[]}],"isInner":true},{"id":"dc07","elType":"container","settings":{"content_width":"full","width":{"unit":"%","size":31},"_css_classes":"dt-cap-card"},"elements":[{"id":"dc08","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"dt-cap-card\" style=\"border:none;padding:0;\"><h4>Large-Format Drilling</h4><p>Holes in oversized sheet, plate, and fabricated parts beyond standard machine envelopes.</p></div>"},"elements":[]}],"isInner":true},{"id":"dc09","elType":"container","settings":{"content_width":"full","width":{"unit":"%","size":31},"_css_classes":"dt-cap-card"},"elements":[{"id":"dc10","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"dt-cap-card\" style=\"border:none;padding:0;\"><h4>Counter-Bored &amp; Countersunk Holes</h4><p>For flush hardware installation and recessed fastener applications.</p></div>"},"elements":[]}],"isInner":true},{"id":"dc11","elType":"container","settings":{"content_width":"full","width":{"unit":"%","size":31},"_css_classes":"dt-cap-card"},"elements":[{"id":"dc12","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"dt-cap-card\" style=\"border:none;padding:0;\"><h4>Deep-Hole Drilling</h4><p>Extended-depth bores in thick plastic and metal stock with controlled chip evacuation.</p></div>"},"elements":[]}],"isInner":true}],"isInner":false},{"id":"drill13","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":800},"flex_direction":"column","flex_align_items":"center","padding":{"unit":"px","top":"0","right":"40","bottom":"48","left":"40","isLinked":false},"background_background":"classic","background_color":"#F8FAFC"},"elements":[{"id":"drill14","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 0.92rem; color: #666; line-height: 1.75; text-align: center; font-style: italic;\">Drilling plastic requires specific process parameters to prevent cracking, melting, and delamination &mdash; particularly in brittle materials like acrylic and filled engineering plastics. Our operators are experienced in selecting the correct drill geometry, speed, feed, and cooling approach for each material.</p>","align":"center"},"elements":[]}],"isInner":false},{"id":"tap01","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":800},"flex_direction":"column","flex_align_items":"center","padding":{"unit":"px","top":"56","right":"40","bottom":"40","left":"40","isLinked":false},"background_background":"classic","background_color":"#FFFFFF","border_border":"solid","border_width":{"unit":"px","top":"1","right":"0","bottom":"0","left":"0","isLinked":false},"border_color":"#E2E8F0"},"elements":[{"id":"tap02","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p class=\"dt-section-label\" style=\"text-align:center;\">TAPPING</p>","align":"center","_margin":{"unit":"px","top":"0","right":"0","bottom":"8","left":"0","isLinked":false}},"elements":[]},{"id":"tap03","elType":"widget","widgetType":"heading","settings":{"title":"Thread Tapping","header_size":"h2","align":"center","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.8},"typography_font_weight":"700","_margin":{"unit":"px","top":"0","right":"0","bottom":"14","left":"0","isLinked":false}},"elements":[]},{"id":"tap04","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 1.0rem; line-height: 1.8; color: #4A5568; text-align: center;\">Tapping creates internal threaded holes that accept standard fastener threads &mdash; screws, bolts, and threaded rod. At Plastic-Craft, tapping is performed with CNC-controlled machine tapping and precision hand tapping depending on part geometry, material, and thread specification.</p>","align":"center","_margin":{"unit":"px","top":"0","right":"0","bottom":"24","left":"0","isLinked":false}},"elements":[]},{"id":"tap05","elType":"widget","widgetType":"html","settings":{"html":"<ul style=\"list-style:none; padding:0; max-width:650px; margin:0 auto;\">\n<li style=\"font-family:'Lora',serif; font-size:0.95rem; color:#666; line-height:1.7; padding:8px 0 8px 22px; position:relative;\"><span style=\"position:absolute;left:0;top:16px;width:8px;height:8px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Standard thread forms</strong> &mdash; UNC, UNF, metric (M-series), and pipe thread (NPT/BSPT)</li>\n<li style=\"font-family:'Lora',serif; font-size:0.95rem; color:#666; line-height:1.7; padding:8px 0 8px 22px; position:relative;\"><span style=\"position:absolute;left:0;top:16px;width:8px;height:8px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Thread sizes</strong> &mdash; from fine miniature threads through large-diameter pipe threads</li>\n<li style=\"font-family:'Lora',serif; font-size:0.95rem; color:#666; line-height:1.7; padding:8px 0 8px 22px; position:relative;\"><span style=\"position:absolute;left:0;top:16px;width:8px;height:8px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Thread inserts</strong> &mdash; installation of Helicoil, threaded brass inserts, and other thread insert systems into plastic parts for enhanced thread strength and longevity</li>\n<li style=\"font-family:'Lora',serif; font-size:0.95rem; color:#666; line-height:1.7; padding:8px 0 8px 22px; position:relative;\"><span style=\"position:absolute;left:0;top:16px;width:8px;height:8px;background:#1380da;border-radius:50%;display:inline-block;\"></span><strong style=\"color:#03325e;\">Blind tapped holes</strong> &mdash; precisely controlled tap depth for closed-end tapped bores</li>\n</ul>"},"elements":[]},{"id":"tap06","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 0.92rem; color: #666; line-height: 1.75; text-align: center; font-style: italic; margin-top: 24px;\">Tapping plastic presents challenges that differ from metal tapping &mdash; plastic threads are more susceptible to stripping and fatigue under cyclic loading. For applications where threaded joint strength is critical, we recommend discussing thread insert options which dramatically improve load capacity and service life in plastic threaded connections.</p>","align":"center"},"elements":[]}],"isInner":false},{"id":"perf01","elType":"container","settings":{"content_width":"boxed","boxed_width":{"unit":"px","size":800},"flex_direction":"column","flex_align_items":"center","padding":{"unit":"px","top":"56","right":"40","bottom":"48","left":"40","isLinked":false},"background_background":"classic","background_color":"#F8FAFC","border_border":"solid","border_width":{"unit":"px","top":"1","right":"0","bottom":"0","left":"0","isLinked":false},"border_color":"#E2E8F0"},"elements":[{"id":"perf02","elType":"widget","widgetType":"text-editor","