    {"id":"css002","elType":"widget","widgetType":"html","settings":{"html":"<style>\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Alice&family=Montserrat:wght@300;400;500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');\n\n:root {\n  --color-primary:        #1380da;\n  --color-primary-light:  #64b7f0;\n  --color-primary-pale:   #d0e9fd;\n  --color-primary-bright: #2e8eff;\n  --color-accent-blue:    #031aec;\n  --color-accent-indigo:  #0b108b;\n  --color-navy:           #07276e;\n  --color-navy-deep:      #03325e;\n  --color-white:          #ffffff;\n  --color-gray:           #666666;\n  --color-gray-blue:      #83b1d1;\n  --color-gray-light:     #d4e1ed;\n  --font-heading:    'Playfair Display', Georgia, serif;\n  --font-body:       'Lora', Georgia, serif;\n  --font-ui:         'Montserrat', sans-serif;\n  --max-width:       1200px;\n  --border-radius:   6px;\n  --shadow-sm:  0 1px 3px rgba(3,50,94,0.08);\n  --shadow-md:  0 4px 12px rgba(3,50,94,0.12);\n  --shadow-lg:  0 8px 30px rgba(3,50,94,0.16);\n}\n\n/* ── PROCESS CARDS CAROUSEL ── */\n.process-track-wrapper {\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n}\n\n.process-track-wrapper::before,\n.process-track-wrapper::after {\n  content: '';\n  position: absolute;\n  top: 0; bottom: 0;\n  width: 60px;\n  z-index: 2;\n  pointer-events: none;\n}\n\n.process-track-wrapper::before {\n  left: 0;\n  background: linear-gradient(90deg, var(--color-white), transparent);\n}\n\n.process-track-wrapper::after {\n  right: 0;\n  background: linear-gradient(270deg, var(--color-white), transparent);\n}\n\n.process-track {\n  display: flex;\n  gap: 24px;\n  padding: 10px 40px 20px;\n  overflow-x: auto;\n  scroll-snap-type: x mandatory;\n  -webkit-overflow-scrolling: touch;\n  scrollbar-width: thin;\n  scrollbar-color: var(--color-primary-pale) transparent;\n}\n\n.process-track::-webkit-scrollbar {\n  height: 6px;\n}\n\n.process-track::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n.process-track::-webkit-scrollbar-thumb {\n  background: var(--color-primary-pale);\n  border-radius: 3px;\n}\n\n.process-card {\n  flex: 0 0 280px;\n  scroll-snap-align: start;\n  background: #f8fafc;\n  border: 1px solid var(--color-gray-light);\n  border-radius: var(--border-radius);\n  padding: 28px 24px;\n  transition: box-shadow 0.3s ease, transform 0.3s ease;\n}\n\n.process-card:hover {\n  box-shadow: var(--shadow-md);\n  transform: translateY(-3px);\n}\n\n.process-card .step-num {\n  display: inline-block;\n  width: 32px; height: 32px;\n  line-height: 32px;\n  text-align: center;\n  background: var(--color-primary);\n  color: #fff;\n  border-radius: 50%;\n  font-family: var(--font-ui);\n  font-size: 0.8rem;\n  font-weight: 700;\n  margin-bottom: 14px;\n}\n\n.process-card h4 {\n  font-family: var(--font-ui);\n  font-size: 0.95rem;\n  font-weight: 700;\n  color: var(--color-navy-deep);\n  margin-bottom: 10px;\n  line-height: 1.3;\n}\n\n.process-card p {\n  font-family: var(--font-body);\n  font-size: 0.85rem;\n  color: var(--color-gray);\n  line-height: 1.65;\n}\n\n.process-dots {\n  display: flex;\n  justify-content: center;\n  gap: 8px;\n  margin-top: 20px;\n}\n\n.process-dots span {\n  width: 8px; height: 8px;\n  border-radius: 50%;\n  background: var(--color-gray-light);\n  cursor: pointer;\n  transition: background 0.3s;\n}\n\n.process-dots span.active {\n  background: var(--color-primary);\n}\n\n/* ── FAQ STYLES ── */\n.faq-item {\n  border-bottom: 1px solid var(--color-gray-light);\n  padding: 24px 0;\n}\n\n.faq-item:last-child {\n  border-bottom: none;\n}\n\n.faq-q {\n  font-family: var(--font-ui);\n  font-size: 1rem;\n  font-weight: 600;\n  color: var(--color-navy-deep);\n  cursor: pointer;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 16px;\n}\n\n.faq-q::after {\n  content: '+';\n  font-size: 1.3rem;\n  font-weight: 300;\n  color: var(--color-primary);\n  transition: transform 0.3s;\n  flex-shrink: 0;\n}\n\n.faq-item.open .faq-q::after {\n  content: '\\2212';\n}\n\n.faq-a {\n  max-height: 0;\n  overflow: hidden;\n  transition: max-height 0.4s ease, padding 0.3s ease;\n  padding-top: 0;\n}\n\n.faq-item.open .faq-a {\n  max-height: 600px;\n  padding-top: 14px;\n}\n\n.faq-a p {\n  font-family: var(--font-body);\n  font-size: 0.92rem;\n  color: var(--color-gray);\n  line-height: 1.75;\n}\n\n/* ── SCROLL ANIMATIONS ── */\n.cap-page-fade {\n  opacity: 0;\n  transform: translateY(20px);\n  transition: opacity 0.6s ease, transform 0.6s ease;\n}\n\n.cap-page-fade.visible {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n/* ── RESPONSIVE ── */\n@media (max-width: 900px) {\n  .process-card {\n    flex: 0 0 260px;\n  }\n}\n\n@media (max-width: 600px) {\n  .process-card {\n    flex: 0 0 240px;\n  }\n}\n</style>"},"elements":[]}
  ],"isInner":false},

