    {"id":"cta002","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 1.05rem; color: #03325e; line-height: 1.6; text-align: center;\">Not sure if CNC engraving is the right fit for your project? Our team is happy to review your specs and point you in the right direction. <a href=\"/contact/\" style=\"color:#1380da; font-weight:600; text-decoration:none; border-bottom:2px solid #1380da;\">Contact Us</a></p>","align":"center"},"elements":[]}
