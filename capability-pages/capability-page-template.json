    {"id":"wis002","elType":"widget","widgetType":"heading","settings":{"title":"What Is CNC Engraving?","header_size":"h2","align":"center","title_color":"#03325e","typography_typography":"custom","typography_font_family":"Playfair Display","typography_font_size":{"unit":"rem","size":1.8},"typography_font_weight":"700","_margin":{"unit":"px","top":"0","right":"0","bottom":"14","left":"0","isLinked":false}},"elements":[]},
    {"id":"wis003","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p style=\"font-family: 'Lora', serif; font-size: 1.05rem; line-height: 1.85; color: #4A5568; text-align: center;\">CNC (Computer Numerical Control) engraving is a precision manufacturing process in which computer-controlled machines use rotating cutting tools to carve designs, text, logos, and patterns directly into a material&rsquo;s surface. Unlike manual engraving, CNC technology eliminates human error and produces consistent, highly detailed results &mdash; even across large runs or complex artwork.</p><p style=\"font-family: 'Lora', serif; font-size: 1.05rem; line-height: 1.85; color: #4A5568; text-align: center;\">At Plastic-Craft, our CNC engraving process is optimized specifically for plastic materials, including acrylic and polycarbonate. The result is a clean, professional finish that holds fine detail and stands up to real-world use &mdash; whether that&rsquo;s a decorative panel, an industrial nameplate, or a branded display component.</p>","align":"center"},"elements":[]}
  ],"isInner":false},

