                      }
                    },
                    {
                      "id": "pc-post-title",
                      "elType": "widget",
                      "widgetType": "theme-post-title",
                      "settings": {
                        "title_color": "#FFFFFF",
                        "typography_typography": "custom",
                        "typography_font_family": "Montserrat",
                        "typography_font_size": {
                          "unit": "em",
                          "size": 2.1
                        },
                        "typography_font_weight": "800",
                        "typography_line_height": {
                          "unit": "em",
                          "size": 1.2
                        },
                        "_margin": {
                          "unit": "px",
                          "top": "0",
                          "right": "0",
                          "bottom": "16",
                          "left": "0",
                          "isLinked": false
