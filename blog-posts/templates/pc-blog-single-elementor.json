                        "object_fit": "cover",
                        "border_border": "solid",
                        "border_width": {
                          "unit": "px",
                          "top": "2",
                          "right": "2",
                          "bottom": "2",
                          "left": "2",
                          "isLinked": true
                        },
                        "border_color": "rgba(255,255,255,0.12)",
                        "border_radius": {
                          "unit": "px",
                          "top": "10",
                          "right": "10",
                          "bottom": "10",
                          "left": "10",
                          "isLinked": true
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
