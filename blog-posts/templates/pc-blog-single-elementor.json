          "unit": "px",
          "top": "48",
          "right": "30",
          "bottom": "40",
          "left": "30",
          "isLinked": false
        },
        "layout": "boxed",
        "content_width": {
          "unit": "px",
          "size": 900
        }
      },
      "elements": [
        {
          "id": "pc-hero-row",
          "elType": "column",
          "settings": {
            "content_position": "center",
            "_column_size": 100
          },
          "elements": [
            {
              "id": "pc-breadcrumb",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<a href=\"/\" style=\"color:#6AABF0;text-decoration:none;\">Home</a> <span style=\"opacity:0.4;margin:0 8px;\">/</span> <a href=\"/blog/\" style=\"color:#6AABF0;text-decoration:none;\">Blog</a>",
                "text_color": "#FFFFFF",
