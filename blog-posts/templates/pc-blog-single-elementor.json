                "_margin": {
                  "unit": "px",
                  "top": "0",
                  "right": "0",
                  "bottom": "20",
                  "left": "0",
                  "isLinked": false
                }
              }
            },
            {
              "id": "pc-hero-columns",
              "elType": "section",
