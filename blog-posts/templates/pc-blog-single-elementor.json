                      }
                    },
                    {
                      "id": "pc-post-meta",
                      "elType": "widget",
                      "widgetType": "theme-post-info",
                      "settings": {
                        "meta_data": ["date", "time", "comments"],
                        "text_color": "rgba(255,255,255,0.8)",
                        "typography_typography": "custom",
                        "typography_font_family": "Montserrat",
                        "typography_font_size": {
                          "unit": "em",
                          "size": 0.75
                        },
                        "typography_font_weight": "500"
                      }
                    }
                  ]
                },
                {
                  "id": "pc-image-col",
                  "elType": "column",
                  "settings": {
                    "_column_size": 25,
                    "content_position": "center",
                    "align": "center"
